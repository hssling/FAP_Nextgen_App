# Supabase Configuration
# Copy this file to .env and fill in your actual values

# Get these from your Supabase project dashboard:
# https://app.supabase.com/project/_/settings/api

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ==========================================
# AI MEDICAL COACH - FREE API OPTIONS
# ==========================================
# You only need ONE of these. All are FREE!

# OPTION 1: OpenRouter (Recommended - Multiple free models)
# Get your free API key from: https://openrouter.ai/keys
# Sign up with Google, no credit card required
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here

# OPTION 2: Groq (Very fast inference)
# Get your free API key from: https://console.groq.com/keys
# Generous free tier, very fast responses
VITE_GROQ_API_KEY=your_groq_api_key_here

# OPTION 3: Google AI Studio (Gemini models)
# Get your free API key from: https://aistudio.google.com/app/apikey
# Free with Google account, no credit card
VITE_GOOGLE_AI_KEY=your_google_ai_key_here

# Note: Never commit .env file to git!
# The .env file is already in .gitignore
