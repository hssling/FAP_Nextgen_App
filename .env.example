# Supabase Configuration
# Copy this file to .env and fill in your actual values

# Get these from your Supabase project dashboard:
# https://app.supabase.com/project/_/settings/api

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ==========================================
# AI MEDICAL COACH - FREE API OPTIONS
# ==========================================
# All of these are FREE options! You can use any or all of them.

# 1. OpenRouter (Recommended - Multiple free models)
# Get your free API key from: https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here

# 2. xAI (Grok models)
# Get your API key from: https://console.x.ai/
VITE_xAI_API_KEY=your_xai_api_key_here

# 3. Google AI Studio (Gemini models)
# Get your free API key from: https://aistudio.google.com/app/apikey
VITE_GOOGLE_AI_KEY=your_google_ai_key_here

# 4. Mistral AI (Native Mistral models)
# Get your API key from: https://console.mistral.ai/
VITE_MISTRAL_API_KEY=your_mistral_api_key_here

# 5. Cerebras (Extreme speed Llama models)
# Get your API key from: https://cloud.cerebras.ai/
VITE_CEREBRAS_API_KEY=your_cerebras_api_key_here

# 6. Hugging Face (Open source models)
# Get your API key from: https://huggingface.co/settings/tokens
VITE_HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Note: Never commit .env file to git!
# The .env file is already in .gitignore
